diff --git a/lib/limits.js b/lib/limits.js
new file mode 100644
index 0000000..f865066
--- /dev/null
+++ b/lib/limits.js
@@ -0,0 +1,56 @@
+'use strict';
+
+const MAX_DEPTH = 100;
+const MAX_NODES = 20000;
+
+/** Reject structures that cannot safely reach the recursive upstream walkers. */
+const assertAst = ast => {
+  const frames = [{ node: ast, depth: 0, index: -1 }];
+  const active = new WeakSet();
+  let visited = 0;
+  while (frames.length !== 0) {
+    const frame = frames[frames.length - 1];
+    const node = frame.node;
+    if (frame.index === -1) {
+      if (node === null || typeof node !== 'object' || Array.isArray(node)) {
+        throw new TypeError('Expected an AST node');
+      }
+      if (frame.depth > MAX_DEPTH || ++visited > MAX_NODES || active.has(node)) {
+        throw new SyntaxError('Brace AST exceeds safe traversal limits');
+      }
+      if (node.value !== undefined && typeof node.value !== 'string') {
+        throw new TypeError('Expected an AST string value');
+      }
+      if (node.nodes !== undefined && !Array.isArray(node.nodes)) {
+        throw new TypeError('Expected AST children to be an array');
+      }
+      let parent = node.parent;
+      const parents = new WeakSet([node]);
+      let height = 0;
+      while (parent !== undefined && parent !== null) {
+        if (typeof parent !== 'object' || parents.has(parent) || ++height > MAX_DEPTH) {
+          throw new SyntaxError('Brace AST has an unsafe parent chain');
+        }
+        parents.add(parent);
+        parent = parent.parent;
+      }
+      active.add(node);
+      frame.index = 0;
+    }
+    if (node.nodes && frame.index < node.nodes.length) {
+      frames.push({ node: node.nodes[frame.index++], depth: frame.depth + 1, index: -1 });
+    } else {
+      active.delete(node);
+      frames.pop();
+    }
+  }
+};
+
+/** Keep parser-created nesting below the same immutable walker bound. */
+const assertNesting = stackSize => {
+  if (stackSize >= MAX_DEPTH) {
+    throw new SyntaxError('Brace pattern exceeds safe nesting limit');
+  }
+};
+
+module.exports = { assertAst, assertNesting };
